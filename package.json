{
  "name": "futbol",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler pages dev ./dist",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply futbol-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply futbol-db --remote",
    "db:seed:local": "wrangler d1 execute futbol-db --local --file=./db/seed-2026.sql",
    "import:anwp": "node scripts/import-anwp.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
