{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "futbol",
  "compatibility_date": "2026-11-01",
  // Dirección pública futbol.<subdominio>.workers.dev (mientras es una prueba)
  "workers_dev": true,
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "futbol-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "futbol-db",
      "database_id": "cf40743c-3b2e-4e74-934b-d6f881b2d845",
      "migrations_dir": "db/migrations"
    }
  ]
}
