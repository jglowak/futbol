---
interface Props { title: string; back?: string }
const { title, back } = Astro.props;
const user = Astro.locals.session?.user;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a6b3d" />
    <link rel="manifest" href="/admin-manifest.webmanifest" />
    <title>{title} · Panel</title>
    <style is:global>
      :root { --bg:#f3f5f7; --card:#fff; --ink:#14181f; --muted:#5b6575; --line:#dfe3e8; --accent:#0a6b3d; --live:#d6291f; --warn:#b36b00; }
      * { box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
      html { font-size:17px; }
      body { margin:0; font:1rem/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; background:var(--bg); color:var(--ink); padding-bottom:env(safe-area-inset-bottom); }
      header { position:sticky; top:0; z-index:5; background:var(--accent); color:#fff; display:flex; align-items:center; gap:.6rem; padding:.7rem .9rem; padding-top:calc(.7rem + env(safe-area-inset-top)); }
      header a { color:#fff; text-decoration:none; font-weight:700; }
      header .title { flex:1; font-weight:700; }
      header .user { font-size:.75rem; opacity:.85; }
      main { max-width:640px; margin:0 auto; padding:.9rem; }
      h2 { font-size:.85rem; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); margin:1.2rem 0 .5rem; }
      .card { background:var(--card); border:1px solid var(--line); border-radius:12px; overflow:hidden; }
      .row { display:grid; grid-template-columns:1fr auto 1fr; gap:.5rem; align-items:center; padding:.85rem .9rem; text-decoration:none; color:inherit; }
      .row + .row { border-top:1px solid var(--line); }
      .row .home { text-align:right; }
      .row .score { font-weight:800; font-size:1.15rem; min-width:3.2rem; text-align:center; border-radius:8px; padding:.15rem .4rem; background:var(--bg); }
      .row .meta { grid-column:1/-1; font-size:.78rem; color:var(--muted); text-align:center; }
      .live { color:var(--live); font-weight:700; }
      .crest { vertical-align:middle; object-fit:contain; }
      .empty { padding:.9rem; color:var(--muted); font-size:.9rem; }
      /* Partido */
      .board { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:.4rem; padding:1rem .6rem; text-align:center; }
      .board .team { font-weight:700; font-size:.95rem; }
      .board .big { font-size:3.2rem; font-weight:800; line-height:1; }
      .board .vs { font-size:1.6rem; color:var(--muted); }
      .btns { display:grid; grid-template-columns:1fr 1fr; gap:.6rem; padding:0 .6rem .9rem; }
      button, .btn { font:inherit; font-weight:700; border:0; border-radius:12px; min-height:56px; cursor:pointer; color:#fff; background:var(--accent); width:100%; }
      button.minus { background:#fff; color:var(--ink); border:1px solid var(--line); min-height:44px; }
      button.danger { background:var(--live); }
      button.warn { background:var(--warn); }
      button.ghost { background:#fff; color:var(--ink); border:1px solid var(--line); }
      button.current { outline:3px solid var(--accent); outline-offset:-3px; }
      .status-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:.6rem; }
      .minute { display:flex; gap:.6rem; align-items:center; }
      .minute input { font:inherit; font-size:1.2rem; width:5.5rem; padding:.6rem; border:1px solid var(--line); border-radius:10px; text-align:center; }
      .history { font-size:.82rem; color:var(--muted); }
      .history li { padding:.35rem 0; border-top:1px solid var(--line); }
      form.inline { display:contents; }
      .notice { background:#fff7e0; border:1px solid #f1dc9a; border-radius:10px; padding:.7rem .9rem; font-size:.88rem; margin-bottom:.8rem; }
      .relato-form textarea { width:100%; font:inherit; padding:.6rem; border:1px solid var(--line); border-radius:10px; margin:.5rem 0; }
      .relato-row { display:flex; gap:.5rem; }
      .relato-row input, .relato-row select { font:inherit; font-size:1rem; padding:.55rem; border:1px solid var(--line); border-radius:10px; }
      .relato-row input { width:5.5rem; text-align:center; } .relato-row select { flex:1; }
      .small { font-size:.8rem; color:var(--muted); }
      .admin-posts { list-style:none; padding:0; margin:.8rem 0 0; font-size:.9rem; }
      .admin-posts li { display:grid; grid-template-columns:2.4rem 1fr auto; gap:.4rem; align-items:start; padding:.45rem 0; border-top:1px solid var(--line); }
      .admin-posts .min { font-weight:800; color:var(--accent); } .admin-posts small { color:var(--muted); text-transform:uppercase; font-size:.68rem; }
      button.tiny { min-height:34px; width:auto; padding:0 .7rem; font-size:.85rem; }
      .admin-photos { display:grid; grid-template-columns:repeat(auto-fill, minmax(120px,1fr)); gap:.5rem; margin-top:.8rem; }
      .admin-photos figure { margin:0; } .admin-photos img { width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:8px; display:block; margin-bottom:.3rem; }
      .edit-form { padding:.9rem; display:grid; gap:.7rem; }
      .edit-form label { display:grid; gap:.25rem; font-size:.85rem; color:var(--muted); }
      .edit-form input, .edit-form select { font:inherit; font-size:1rem; padding:.6rem; border:1px solid var(--line); border-radius:10px; color:var(--ink); background:#fff; }
      .login { max-width:360px; margin:3rem auto; }
      .login input { font:inherit; font-size:1.1rem; width:100%; padding:.8rem; border:1px solid var(--line); border-radius:10px; margin:.5rem 0 1rem; }
      .err { color:var(--live); font-size:.9rem; }
    </style>
  </head>
  <body>
    <header>
      {back ? <a href={back} aria-label="Volver">‹</a> : null}
      <span class="title">{title}</span>
      {user && <span class="user">{user}</span>}
      {user && <a href="/admin/torneos" style="font-size:.8rem;font-weight:400">Torneos</a>}
      {user && <a href="/admin/logout" style="font-size:.75rem;font-weight:400">salir</a>}
    </header>
    <main><slot /></main>
  </body>
</html>
