---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Resultados, tablas y fixture del fútbol del interior.' } = Astro.props;
// Caché corta en el borde de Cloudflare: rápido, pero los resultados se ven casi al instante.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=10, stale-while-revalidate=30');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" /> <!-- Quitar al pasar a producción -->
    <style is:global>
      :root { --bg:#f6f7f9; --card:#fff; --ink:#14181f; --muted:#5b6575; --line:#e3e6eb; --accent:#0a6b3d; --live:#d6291f; }
      * { box-sizing: border-box; }
      body { margin:0; font:16px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; background:var(--bg); color:var(--ink); }
      header { background:var(--accent); color:#fff; }
      header .wrap { display:flex; align-items:center; gap:1rem; padding:.8rem 1rem; }
      header a { color:#fff; text-decoration:none; font-weight:700; }
      main { max-width:960px; margin:0 auto; padding:1rem; }
      h1 { font-size:1.4rem; margin:.2rem 0 1rem; }
      h2 { font-size:1.1rem; margin:1.5rem 0 .6rem; }
      a { color:var(--accent); }
      .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:.25rem 0; overflow-x:auto; }
      table { width:100%; border-collapse:collapse; font-size:.95rem; }
      th, td { padding:.5rem .6rem; text-align:right; white-space:nowrap; }
      th:nth-child(-n+2), td:nth-child(-n+2) { text-align:left; }
      th { font-size:.75rem; text-transform:uppercase; color:var(--muted); border-bottom:1px solid var(--line); }
      tbody tr + tr td { border-top:1px solid var(--line); }
      td.pts { font-weight:700; }
      .match { display:grid; grid-template-columns:1fr auto 1fr; gap:.6rem; align-items:center; padding:.6rem .8rem; }
      .match + .match { border-top:1px solid var(--line); }
      .match .home { text-align:right; } .match .score { font-weight:700; min-width:3.5rem; text-align:center; }
      .match .meta { grid-column:1/-1; color:var(--muted); font-size:.8rem; text-align:center; }
      .live { color:var(--live); font-weight:700; }
      .note { color:var(--muted); font-size:.8rem; margin:.4rem .2rem; }
      .crest { display:inline-block; vertical-align:middle; object-fit:contain; }
      a.match { text-decoration:none; color:inherit; }
      .card.pad { padding:.9rem; }
      .live-dot { color:var(--live); font-weight:700; }
      .is-live .live-dot, .live-block h2 .live-dot { animation: blink 1.2s ease-in-out infinite; }
      @keyframes blink { 0%, 100% { opacity:1; } 50% { opacity:.25; } }
      @media (prefers-reduced-motion: reduce) { .live-dot { animation:none !important; } }
      /* Marcador */
      .scoreboard { display:grid; grid-template-columns:1fr auto 1fr; gap:.6rem; align-items:center; text-align:center; }
      .scoreboard .team { display:flex; flex-direction:column; align-items:center; gap:.3rem; color:inherit; text-decoration:none; font-weight:600; font-size:.9rem; }
      .scoreboard .num { font-weight:800; font-size:1.4rem; white-space:nowrap; }
      .scoreboard .state { font-size:.78rem; color:var(--muted); }
      .scoreboard.big .num { font-size:2.6rem; }
      .scoreboard.big .team { font-size:1rem; }
      .scoreboard.is-live .num { color:var(--live); }
      .scoreboard .team, .live-card .team { color:var(--ink); }
      /* En vivo */
      .live-block { margin-bottom:1rem; }
      .live-block h2 { margin:.2rem 0 .5rem; }
      .live-card { display:block; background:var(--card); border:2px solid var(--live); border-radius:12px; padding:.8rem; margin-bottom:.6rem; text-decoration:none; color:inherit; }
      .live-card .meta { text-align:center; font-size:.78rem; color:var(--muted); margin-top:.5rem; }
      /* Relato y fotos */
      ol.posts { list-style:none; margin:0; padding:0; }
      .post { display:grid; grid-template-columns:2.6rem 1fr; gap:.5rem; padding:.6rem 0; }
      .post + .post { border-top:1px solid var(--line); }
      .post .min { font-weight:800; color:var(--accent); }
      .post .body p { margin:0 0 .25rem; }
      .post .tag { display:inline-block; font-size:.72rem; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); margin-bottom:.15rem; }
      .post.kind-goal .min { color:var(--live); }
      .photos { display:grid; grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); gap:.5rem; margin:.8rem 0; }
      .photos figure { margin:0; }
      .photos img { width:100%; height:auto; aspect-ratio:4/3; object-fit:cover; border-radius:10px; display:block; }
      .photos figcaption { font-size:.75rem; color:var(--muted); margin-top:.2rem; }
      .crest-empty { border-radius:50%; background:var(--line); }
      td.club { white-space:nowrap; }
      .short { display:none; }
      @media (max-width: 640px) { .full { display:none; } .short { display:inline; } th, td { padding:.45rem .4rem; } }
      ul.links { list-style:none; padding:0; display:flex; flex-wrap:wrap; gap:.5rem; }
      ul.links a { display:inline-block; padding:.4rem .8rem; background:var(--card); border:1px solid var(--line); border-radius:999px; text-decoration:none; }
    </style>
  </head>
  <body>
    <header><div class="wrap"><a href="/">⚽ Fútbol Florida · prueba</a></div></header>
    <main><slot /></main>
    <script>
      // Refresco por bloque: cada [data-refresh] pide su "partial" y reemplaza solo
      // las secciones (hijos con id) que cambiaron. Nada se recarga entero.
      const blocks = Array.from(document.querySelectorAll('[data-refresh]'));
      const swap = (cur, next) => {
        const curKids = Array.from(cur.children).filter((el) => el.id);
        const nextKids = Array.from(next.children).filter((el) => el.id);
        if (curKids.length && curKids.length === nextKids.length && curKids.every((el, i) => el.id === nextKids[i].id)) {
          curKids.forEach((el, i) => { if (el.innerHTML !== nextKids[i].innerHTML) el.innerHTML = nextKids[i].innerHTML; });
        } else if (cur.innerHTML !== next.innerHTML) {
          cur.innerHTML = next.innerHTML;
        }
      };
      const refresh = async (el) => {
        if (document.hidden) return;
        try {
          const res = await fetch(el.dataset.refresh, { cache: 'no-store' });
          if (!res.ok) return;
          const next = document.createElement('div');
          next.innerHTML = await res.text();
          swap(el, next);
        } catch {}
      };
      for (const el of blocks) setInterval(() => refresh(el), Number(el.dataset.refreshEvery) || 20000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) blocks.forEach(refresh); });
    </script>
  </body>
</html>
