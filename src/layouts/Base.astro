---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Resultados, tablas y fixture del fútbol del interior.' } = Astro.props;
// Caché corta en el borde de Cloudflare: rápido, pero los resultados se ven casi al instante.
Astro.response.headers.set('Cache-Control', 'public, max-age=10, s-maxage=20, stale-while-revalidate=60');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" /> <!-- Quitar al pasar a producción -->
    <style is:global>
      :root { --bg:#f6f7f9; --card:#fff; --ink:#14181f; --muted:#5b6575; --line:#e3e6eb; --accent:#0a6b3d; --live:#d6291f; }
      * { box-sizing: border-box; }
      body { margin:0; font:16px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; background:var(--bg); color:var(--ink); }
      header { background:var(--accent); color:#fff; }
      header .wrap { display:flex; align-items:center; gap:1rem; padding:.8rem 1rem; }
      header a { color:#fff; text-decoration:none; font-weight:700; }
      main { max-width:960px; margin:0 auto; padding:1rem; }
      h1 { font-size:1.4rem; margin:.2rem 0 1rem; }
      h2 { font-size:1.1rem; margin:1.5rem 0 .6rem; }
      a { color:var(--accent); }
      .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:.25rem 0; overflow-x:auto; }
      table { width:100%; border-collapse:collapse; font-size:.95rem; }
      th, td { padding:.5rem .6rem; text-align:right; white-space:nowrap; }
      th:nth-child(-n+2), td:nth-child(-n+2) { text-align:left; }
      th { font-size:.75rem; text-transform:uppercase; color:var(--muted); border-bottom:1px solid var(--line); }
      tbody tr + tr td { border-top:1px solid var(--line); }
      td.pts { font-weight:700; }
      .match { display:grid; grid-template-columns:1fr auto 1fr; gap:.6rem; align-items:center; padding:.6rem .8rem; }
      .match + .match { border-top:1px solid var(--line); }
      .match .home { text-align:right; } .match .score { font-weight:700; min-width:3.5rem; text-align:center; }
      .match .meta { grid-column:1/-1; color:var(--muted); font-size:.8rem; text-align:center; }
      .live { color:var(--live); font-weight:700; }
      .note { color:var(--muted); font-size:.8rem; margin:.4rem .2rem; }
      ul.links { list-style:none; padding:0; display:flex; flex-wrap:wrap; gap:.5rem; }
      ul.links a { display:inline-block; padding:.4rem .8rem; background:var(--card); border:1px solid var(--line); border-radius:999px; text-decoration:none; }
    </style>
  </head>
  <body>
    <header><div class="wrap"><a href="/">⚽ Fútbol — demo</a></div></header>
    <main><slot /></main>
  </body>
</html>
