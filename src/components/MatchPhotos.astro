---
import type { MatchPhoto } from '../lib/match-content';
interface Props { photos: MatchPhoto[] }
const { photos } = Astro.props;
---
{photos.length > 0 && (
  <div class="photos">
    {photos.map((p) => (
      <figure>
        <a href={`/media/${p.key}`} target="_blank" rel="noopener">
          <img src={`/media/${p.key}`} alt={p.caption ?? ''} loading="lazy" decoding="async" width={p.width ?? undefined} height={p.height ?? undefined} />
        </a>
        {p.caption && <figcaption>{p.caption}</figcaption>}
      </figure>
    ))}
  </div>
)}
