---
import { COOKIE, getSession } from '../../lib/auth';
const session = await getSession(Astro.request);
Astro.cookies.delete(COOKIE, { path: '/' });
// Con Cloudflare Access la sesión la maneja Access: hay que cerrarla ahí, si no vuelve a entrar solo.
return Astro.redirect(session?.via === 'access' ? '/cdn-cgi/access/logout' : '/admin/login', 303);
---
