---
import Admin from '../../layouts/Admin.astro';
import AdminMatchRow from '../../components/AdminMatchRow.astro';
import { adminLists } from '../../lib/admin';
import { env } from 'cloudflare:workers';
import { mediaBucket } from '../../lib/media';
const lists = await adminLists();
const escudosMsg = Astro.url.searchParams.get('escudos');
const pendingCrests = (await env.DB.prepare(`SELECT COUNT(*) AS n FROM clubs WHERE crest_url LIKE 'http%'`).first<{ n: number }>())?.n ?? 0;
const hasR2 = Boolean(mediaBucket());
const Section = (title: string, items: typeof lists.live, empty: string) => ({ title, items, empty });
const sections = [
  Section('En juego', lists.live, ''),
  Section('Hoy', lists.today, 'No hay partidos hoy.'),
  Section('Próximos', lists.upcoming, 'Sin partidos programados.'),
  Section('Últimos resultados', lists.recent, 'Todavía no hay resultados.'),
].filter((s) => s.items.length > 0 || s.empty);
---
<Admin title="Partidos">
  {sections.map((s) => (
    <>
      <h2>{s.title}</h2>
      <div class="card">
        {s.items.length === 0 ? <p class="empty">{s.empty}</p> : s.items.map((m) => <AdminMatchRow m={m} />)}
      </div>
    </>
  ))}
  <p class="history" style="margin-top:1.5rem">Tocá un partido para cargar goles o el resultado final. Todo cambio se puede deshacer.</p>

  <h2>Fixture</h2>
  <div class="card"><a class="row" href="/admin/torneos" style="grid-template-columns:1fr">Torneos, fixture y alta de partidos ›</a></div>

  <h2>Herramientas</h2>
  {escudosMsg && <div class="notice">{escudosMsg === 'sin-r2' ? 'R2 todavía no está conectado al Worker.' : `Escudos copiados: ${escudosMsg}`}</div>}
  <div class="card" style="padding:.9rem">
    <p style="margin:0 0 .6rem;font-size:.9rem">Escudos alojados fuera de Cloudflare: <strong>{pendingCrests}</strong>{!hasR2 && ' · R2 sin conectar'}</p>
    <form method="post" action="/api/admin/escudos/sync">
      <button class="ghost" disabled={!hasR2 || pendingCrests === 0}>Copiar escudos a R2</button>
    </form>
  </div>
</Admin>
