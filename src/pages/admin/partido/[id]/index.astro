---
import Admin from '../../../../layouts/Admin.astro';
import Crest from '../../../../components/Crest.astro';
import { adminMatch, lastUndoableEntry, matchHistory } from '../../../../lib/admin';
import { finishedLabel, formatKickoff, pensText } from '../../../../lib/format';
import { listPhotos, listPosts, POST_KINDS } from '../../../../lib/match-content';
import { mediaBucket } from '../../../../lib/media';
import { getLineup } from '../../../../lib/players';
import { listEvents } from '../../../../lib/events';
import { EVENT_UI, eventIcon, eventLabel, eventDetail } from '../../../../lib/events-core';

const id = Number(Astro.params.id);
const m = Number.isInteger(id) ? await adminMatch(id) : null;
if (!m) return new Response('Partido no encontrado', { status: 404 });

const [history, undoable, posts, photos, lineup, events] = await Promise.all([matchHistory(id, 15), lastUndoableEntry(id), listPosts(id), listPhotos(id), getLineup(id), listEvents(id)]);
const lineupCount = { home: lineup.filter((l) => l.club_id === m.home_id).length, away: lineup.filter((l) => l.club_id === m.away_id).length };
const squads = [
  { label: m.home_name, clubId: m.home_id, players: lineup.filter((l) => l.club_id === m.home_id) },
  { label: m.away_name, clubId: m.away_id, players: lineup.filter((l) => l.club_id === m.away_id) },
];
const hasLineup = lineup.length > 0;
const eventoMsg = Astro.url.searchParams.get('evento');
const fotoMsg = Astro.url.searchParams.get('foto');
const hasR2 = Boolean(mediaBucket());
const back = `/admin/partido/${id}`;
const api = `/api/admin/partido/${id}`;
const isLive = m.status === 'live';
const isFinal = m.status === 'finished';
const hg = m.home_goals ?? 0;
const ag = m.away_goals ?? 0;
const hasScore = m.home_goals !== null && m.away_goals !== null;

const LABEL: Record<string, string> = { scheduled: 'Programado', live: 'En vivo', finished: 'Final', postponed: 'Postergado' };
const describe = (e: (typeof history)[number]) => {
  const b = e.payload.before ?? {}, a = e.payload.after ?? {};
  const score = (s: typeof a) => (s.home_goals === null ? '—' : `${s.home_goals}-${s.away_goals}`);
  if (e.action === 'undo') return `Deshacer → ${score(a)} (${LABEL[a.status] ?? a.status})`;
  if (e.action === 'goal') return `Gol: ${score(b)} → ${score(a)}`;
  if (e.action === 'status') return `Estado: ${LABEL[b.status] ?? b.status} → ${LABEL[a.status] ?? a.status}`;
  if (e.action === 'minute') return `Minuto: ${b.minute ?? '—'} → ${a.minute ?? '—'}`;
  if (e.action === 'pens') return `Penales: ${a.home_pens ?? '—'}-${a.away_pens ?? '—'}`;
  if (e.action === 'create') return 'Partido creado';
  if (e.action === 'edit') return 'Datos del partido editados';
  return e.action;
};
const when = (iso: string) =>
  new Intl.DateTimeFormat('es-UY', { timeZone: 'America/Montevideo', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }).format(new Date(iso + 'Z'));
---
<Admin title={`${m.home_short ?? m.home_name} vs ${m.away_short ?? m.away_name}`} back="/admin">
  <p class="history" style="margin:0 0 .6rem">
    <a href={`/admin/partido/${id}/editar`}>editar datos</a> · <a href={`/partido/${m.slug ?? id}`} target="_blank" rel="noopener">ver en el sitio ↗</a><br />
    {m.tournament_name}{m.group_name ? ` · ${m.group_name}` : ''}{m.round ? ` · ${m.round}` : ''} · {formatKickoff(m.kickoff_at)}
  </p>

  {isFinal && <div class="final-banner">✔ {finishedLabel(m.finished_at)}</div>}
  <div class="card">
    <div class="board">
      <div>
        <Crest src={m.home_crest} name={m.home_name} size={44} />
        <div class="team">{m.home_short ?? m.home_name}</div>
        <div class="big">{m.home_goals ?? '–'}</div>
      </div>
      <div class="vs">
        {isLive ? <span class="live">● {m.minute ? `${m.minute}'` : 'vivo'}</span> : isFinal ? <span class="badge-final">Finalizado</span> : LABEL[m.status] ?? m.status}
        {pensText(m) && <div class="pens">{pensText(m)}</div>}
      </div>
      <div>
        <Crest src={m.away_crest} name={m.away_name} size={44} />
        <div class="team">{m.away_short ?? m.away_name}</div>
        <div class="big">{m.away_goals ?? '–'}</div>
      </div>
    </div>

    <div class="btns">
      <form class="inline" method="post" action={api}><button name="action" value="home_plus">+1 {m.home_short ?? 'Local'}</button></form>
      <form class="inline" method="post" action={api}><button name="action" value="away_plus">+1 {m.away_short ?? 'Visitante'}</button></form>
      <form class="inline" method="post" action={api}><button class="minus" name="action" value="home_minus" disabled={hg === 0}>−1</button></form>
      <form class="inline" method="post" action={api}><button class="minus" name="action" value="away_minus" disabled={ag === 0}>−1</button></form>
    </div>
  </div>

  <h2>Estado</h2>
  <div class="status-grid">
    <form method="post" action={api} onsubmit={hasScore && m.status !== 'scheduled' ? `return confirm('Se va a borrar el resultado ${hg}-${ag} y el partido queda como programado. ¿Seguir?')` : undefined}><button class:list={['ghost', { current: m.status === 'scheduled' }]} name="action" value="scheduled">Programado</button></form>
    <form method="post" action={api} onsubmit={isFinal ? `return confirm('El partido ya está finalizado. Vuelve a En vivo manteniendo el ${hg}-${ag}; la hora de finalización se vuelve a tomar al cerrarlo. ¿Seguir?')` : undefined}><button class:list={['danger', { current: isLive }]} name="action" value="live">En vivo</button></form>
    <form method="post" action={api}><button class:list={[{ current: isFinal }]} name="action" value="finished">Final</button></form>
    <form method="post" action={api} onsubmit={hasScore ? `return confirm('Postergar borra el resultado ${hg}-${ag} y deja el partido a cero. ¿Seguir?')` : undefined}><button class:list={['warn', { current: m.status === 'postponed' }]} name="action" value="postponed">Postergado</button></form>
  </div>

  {isLive && (
    <>
      <h2>Minuto (opcional)</h2>
      <form method="post" action={api} class="minute">
        <input type="number" name="minute" min="0" max="130" inputmode="numeric" value={m.minute ?? ''} placeholder="min" />
        <button name="action" value="minute" style="min-height:48px">Guardar</button>
      </form>
    </>
  )}

  {(isLive || isFinal) && (
    <>
      <h2>Penales (solo si hubo definición)</h2>
      <form method="post" action={api} class="minute">
        <input type="number" name="home_pens" min="0" max="30" inputmode="numeric" value={m.home_pens ?? ''} placeholder={m.home_short ?? 'Local'} aria-label="Penales local" />
        <span>-</span>
        <input type="number" name="away_pens" min="0" max="30" inputmode="numeric" value={m.away_pens ?? ''} placeholder={m.away_short ?? 'Visitante'} aria-label="Penales visitante" />
        <button name="action" value="pens" style="min-height:48px">Guardar</button>
      </form>
      <p class="small">Para el alargue no hace falta nada especial: seguí sumando goles y cargá el minuto (91 a 120). Dejá los penales vacíos para quitarlos.</p>
    </>
  )}

  <h2 id="alineacion">Alineación</h2>
  <a class="lineup-link" href={`/admin/partido/${id}/planilla`}>
    <span>Cargar / revisar planilla</span>
    <span class="small">{m.home_short ?? m.home_name}: {lineupCount.home || '—'} · {m.away_short ?? m.away_name}: {lineupCount.away || '—'}</span>
  </a>

  <h2 id="eventos">Goles, tarjetas y cambios</h2>
  {eventoMsg && <div class="notice" style="background:#fde8e6;border-color:#f3b3ad">{eventoMsg}</div>}
  <div class="card" style="padding:.9rem">
    <form method="post" action={`${api}/evento`} class="evento-form">
      <div class="evento-row">
        <input type="number" name="minute" min="0" max="130" inputmode="numeric" placeholder="min'" aria-label="Minuto" />
        <select name="tipo" id="ev-tipo" aria-label="Tipo">
          {Object.entries(EVENT_UI).map(([k, v]) => <option value={k}>{v.icon} {v.label}</option>)}
        </select>
      </div>
      {hasLineup ? (
        <select name="player" aria-label="Jugador">
          <option value="">— elegí el jugador —</option>
          {squads.map((s) => s.players.length > 0 && (
            <optgroup label={s.label}>
              {s.players.map((p) => <option value={`${s.clubId}:${p.player_id}`}>{p.shirt_number != null ? `${p.shirt_number}. ` : ''}{p.full_name}</option>)}
            </optgroup>
          ))}
        </select>
      ) : (
        <div class="evento-free">
          <div class="evento-radios">
            <label><input type="radio" name="club" value="home" checked /> {m.home_short ?? m.home_name}</label>
            <label><input type="radio" name="club" value="away" /> {m.away_short ?? m.away_name}</label>
          </div>
          <input type="text" name="player_name" maxlength="120" placeholder="Nombre del jugador" />
          <p class="small">Cargá la planilla para elegir del plantel en vez de escribir.</p>
        </div>
      )}
      <div id="ev-out" hidden>
        {hasLineup ? (
          <select name="out" aria-label="Sale (cambio)">
            <option value="">— sale (opcional) —</option>
            {squads.map((s) => s.players.length > 0 && (
              <optgroup label={s.label}>
                {s.players.map((p) => <option value={`${s.clubId}:${p.player_id}`}>{p.shirt_number != null ? `${p.shirt_number}. ` : ''}{p.full_name}</option>)}
              </optgroup>
            ))}
          </select>
        ) : (
          <input type="text" name="out_name" maxlength="120" placeholder="Sale (opcional)" />
        )}
      </div>
      <button type="submit" style="min-height:48px">Agregar evento</button>
    </form>
    {events.length > 0 && (
      <ul class="admin-posts">
        {events.map((e) => (
          <li>
            <span class="min">{e.minute !== null ? `${e.minute}'` : '—'}</span>
            <span class="body"><small>{eventIcon(e.type)} {eventLabel(e.type)}</small> {eventDetail({ type: e.type, playerName: e.playerName, relatedName: e.relatedName })}</span>
            <form method="post" action={`/api/admin/evento/${e.id}`}>
              <input type="hidden" name="back" value={`${back}#eventos`} />
              <button name="action" value="delete" class="link-danger" aria-label="Borrar">✕</button>
            </form>
          </li>
        ))}
      </ul>
    )}
  </div>
  <script is:inline>
    (function () {
      var sel = document.getElementById('ev-tipo'), out = document.getElementById('ev-out');
      if (!sel || !out) return;
      function sync() { out.hidden = sel.value !== 'cambio'; }
      sel.addEventListener('change', sync); sync();
    })();
  </script>

  <h2 id="relato">Relato</h2>
  <div class="card" style="padding:.9rem">
    <form method="post" action={`${api}/relato`} class="relato-form">
      <div class="relato-row">
        <input type="number" name="minute" min="0" max="130" inputmode="numeric" placeholder={isLive && m.minute ? `${m.minute}'` : "min'"} aria-label="Minuto" />
        <select name="kind" aria-label="Tipo">
          {Object.entries(POST_KINDS).filter(([k]) => ['text', 'info', 'start', 'end'].includes(k)).map(([k, label]) => <option value={k}>{label}</option>)}
        </select>
      </div>
      {isLive && m.minute && <label class="small"><input type="checkbox" name="use_current_minute" value="1" checked /> usar el minuto actual si no escribo uno</label>}
      <textarea name="body" rows="3" maxlength="2000" required placeholder="Qué pasó… (gol de Fulano de cabeza, cambio, expulsión, o un comentario)"></textarea>
      <button type="submit" style="min-height:48px">Publicar</button>
    </form>
    {posts.length > 0 && (
      <ul class="admin-posts">
        {posts.map((p) => (
          <li>
            <span class="min">{p.minute !== null ? `${p.minute}'` : '—'}</span>
            <span class="body"><small>{POST_KINDS[p.kind]}</small> {p.body}</span>
            <form method="post" action={`/api/admin/relato/${p.id}`}>
              <input type="hidden" name="back" value={`${back}#relato`} />
              <button class="ghost tiny" name="action" value="delete" aria-label="Borrar">✕</button>
            </form>
          </li>
        ))}
      </ul>
    )}
  </div>

  <h2 id="fotos">Fotos</h2>
  {fotoMsg && <div class="notice">{fotoMsg === 'ok' ? 'Foto subida.' : fotoMsg === 'vacia' ? 'Elegí una foto.' : `No se pudo subir: ${fotoMsg}`}</div>}
  <div class="card" style="padding:.9rem">
    {hasR2 ? (
      <form method="post" action={`${api}/foto`} enctype="multipart/form-data" id="foto-form">
        <input type="file" name="photo" accept="image/*" required />
        <input type="hidden" name="width" /><input type="hidden" name="height" />
        <input type="text" name="caption" maxlength="300" placeholder="Epígrafe (opcional)" style="margin:.5rem 0;width:100%;padding:.6rem;border:1px solid var(--line);border-radius:10px;font:inherit" />
        <button type="submit" style="min-height:48px">Subir foto</button>
        <p class="small">La foto se achica en el teléfono antes de subir (máx. 1600 px).</p>
      </form>
    ) : <p class="small">R2 no está conectado: la carga de fotos se habilita cuando lo esté.</p>}
    {photos.length > 0 && (
      <div class="admin-photos">
        {photos.map((p) => (
          <figure>
            <img src={`/media/${p.key}`} alt={p.caption ?? ''} loading="lazy" />
            <form method="post" action={`/api/admin/foto/${p.id}`} onsubmit="return confirm('¿Borrar esta foto?')">
              <input type="hidden" name="back" value={`${back}#fotos`} />
              <button class="danger tiny" name="action" value="delete">Borrar</button>
            </form>
          </figure>
        ))}
      </div>
    )}
  </div>

  <h2>Historial</h2>
  <form method="post" action={api}>
    <button class="ghost" name="action" value="undo" disabled={!undoable}>↶ Deshacer último cambio</button>
  </form>
  {history.length > 0 && (
    <ul class="history" style="list-style:none;padding:0;margin:.6rem 0 0">
      {history.map((e) => <li>{when(e.at)} · {describe(e)} <span style="opacity:.7">({e.actor})</span></li>)}
    </ul>
  )}
  <script>
    // Reduce la foto en el navegador antes de subirla: ahorra datos y espacio en R2.
    const form = document.getElementById('foto-form') as HTMLFormElement | null;
    form?.addEventListener('submit', async (ev) => {
      const input = form.querySelector<HTMLInputElement>('input[name=photo]')!;
      const file = input.files?.[0];
      if (!file || form.dataset.ready === '1') return;
      ev.preventDefault();
      const btn = form.querySelector('button')!;
      btn.disabled = true;
      btn.textContent = 'Preparando…';
      try {
        const bmp = await createImageBitmap(file);
        const MAX = 1600;
        const scale = Math.min(1, MAX / Math.max(bmp.width, bmp.height));
        const w = Math.round(bmp.width * scale), h = Math.round(bmp.height * scale);
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d')!.drawImage(bmp, 0, 0, w, h);
        const blob: Blob = await new Promise((res) => canvas.toBlob((b) => res(b!), 'image/jpeg', 0.82));
        const dt = new DataTransfer();
        dt.items.add(new File([blob], (file.name.replace(/\.[^.]+$/, '') || 'foto') + '.jpg', { type: 'image/jpeg' }));
        input.files = dt.files;
        (form.querySelector('input[name=width]') as HTMLInputElement).value = String(w);
        (form.querySelector('input[name=height]') as HTMLInputElement).value = String(h);
      } catch {
        // Si el navegador no puede procesarla, se sube tal cual (el servidor limita a 4 MB).
      }
      form.dataset.ready = '1';
      btn.textContent = 'Subiendo…';
      form.submit();
    });
  </script>
</Admin>
