---
import Base from '../layouts/Base.astro';
import MatchList from '../components/MatchList.astro';
import LiveBlock from '../components/LiveBlock.astro';
import { getLiveMatches, getStripMatches, listTournaments } from '../lib/db';

const [{ recent, upcoming }, tournaments, live] = await Promise.all([getStripMatches(), listTournaments({ currentSeasonOnly: true }), getLiveMatches()]);
---
<Base title="Fútbol — resultados y tablas">
  <div data-refresh="/partial/en-vivo" data-refresh-every="15000"><LiveBlock matches={live} /></div>
  <h1>Resultados y próximos partidos</h1>
  <h2>Últimos resultados</h2>
  <MatchList matches={recent} showTournament />
  <h2>Próximos partidos</h2>
  <MatchList matches={upcoming} showTournament />
  <h2>Torneos</h2>
  <ul class="links">
    {tournaments.map((t) => <li><a href={`/torneo/${t.slug}`}>{t.name}</a></li>)}
    <li><a href="/torneos">Todos los torneos ›</a></li>
  </ul>
</Base>
